APP_NAME=SmartDine
NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smartdine_db

SESSION_SECRET=replace_with_a_long_random_secret
